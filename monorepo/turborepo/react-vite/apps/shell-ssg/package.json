{
  "name": "shell-ssg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "micro": "npm run build && npm run preview",
    "build": "npm run build:client && npm run build:server && node prerender.js",
    "build:client": "tsc -b && vite build --outDir dist/client",
    "build:server": "tsc -b && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "lint": "eslint .",
    "preview": "sirv dist/client --port 5174 --cors"
  },
  "dependencies": {
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@repo/ui": "*",
    "@repo/utilities": "*",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "i18next": "^25.10.9",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.6.6",
    "react-router": "^7.9.5",
    "sirv": "^3.0.1",
    "@repo/i18n": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "install": "^0.13.0",
    "npm": "^11.6.2",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
